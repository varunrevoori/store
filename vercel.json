{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node scripts/vercel-install.mjs",
  "buildCommand": "npm run build",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "backend/src/**,packages/shared/**,frontend/dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.mjs" }]
}