PORT=8080
# Comma-separated browser origins allowed by Express CORS (must match Vite URL)
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
DEFAULT_VERTICAL=salon

# Supabase Auth (email + password on frontend; API validates JWT on backend)
# Superadmin + real login: MUST be false/false (true skips JWT and breaks /auth/superadmin → 401)
SKIP_AUTH=false
VITE_SKIP_AUTH=false

# Frontend (Vite reads from repo root via envDir)
# Local dev: point at Express. Unified production deploy: leave unset (same-origin).
VITE_API_URL=http://localhost:8080
# SERVE_FRONTEND=1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend — same project URL; service role NEVER expose to the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Schema: run supabase/migrations/001, 002, 004, 006 in Supabase SQL Editor

# First superadmin (dev): matching login auto-enters admin_users on /auth/superadmin (server only)
# BOOTSTRAP_SUPERADMIN_EMAIL=you@example.com
# BOOTSTRAP_SUPERADMIN_USER_ID=323bc2c1-1c2e-4bbc-bc51-aea94085d3dd

# Approve platform requests via internal API (optional)
# PLATFORM_WEBHOOK_SECRET=long-random-secret