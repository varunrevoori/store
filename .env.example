# Copy to `.env` at repo root — same file for local dev; production uses host env vars only (no URL edits in code).

PORT=8080
NODE_ENV=development
DEFAULT_VERTICAL=salon

# --- URLs (local vs production) ---
# Local: Vite :5173 talks to API :8080 — keep both lines below.
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Production (single Vercel/Render app): do NOT set VITE_API_URL (browser uses same origin).
# WEB_ORIGIN is optional on Vercel — auto-filled from VERCEL_URL when unset.
# Optional custom domain: WEB_ORIGIN=https://your-domain.com

# --- Auth ---
SKIP_AUTH=false
VITE_SKIP_AUTH=false

# --- Supabase (same project for frontend + backend) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Schema: run supabase/migrations/*.sql in Supabase SQL Editor

# BOOTSTRAP_SUPERADMIN_EMAIL=you@example.com
# PLATFORM_WEBHOOK_SECRET=long-random-secret